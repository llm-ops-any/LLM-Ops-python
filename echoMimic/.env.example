# EchoMimic 环境变量模板
# 用法：复制为 .env（同目录），按下方说明填真实值。.env 含真实密钥，不得提交。
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# 说明：webgui.py 启动时 dotenv.load_dotenv() 读取本目录 .env。

# ---------- 阿里百炼 TTS（用于「转换为语音」） ----------
# 百炼原生多模态/语音接口（注意：不是 OpenAI 兼容模式的 /compatible-mode/v1/audio/speech，
# 该路径在百炼上返回 404；tts-1 / alloy 这类 OpenAI 模型名在百炼上也不存在）
DASHSCOPE_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
DASHSCOPE_API_KEY=your-dashscope-api-key
# 实测可用：qwen-audio-3.1-tts-flash（配合上面的 SpeechSynthesizer 地址 + longanhuan_v3.1 音色）
# 曾记录：qwen3-tts-flash 走 aigc/multimodal-generation/generation，当前账号返回 400 Arrearage
TTS_MODEL=qwen-audio-3.1-tts-flash
# 常用音色：longanhuan_v3.1（qwen-audio-tts 系列）/ Cherry / Serena / Ethan / Chelsie（qwen3-tts 系列）
TTS_VOICE=longanhuan_v3.1

# ---------- LLMOps 开放 API（用于「获取文案」生成口播词） ----------
# 应用 id：LLMOps 平台 → 应用详情页 URL / 应用设置里取。
LLMOPS_APP_ID=your-app-id
# 开放 API 密钥：LLMOps 平台 → 应用 → 发布 API → 创建密钥（形如 llmops-v1/xxx）。
LLMOPS_API_KEY=your-llmops-api-key
# 对话接口完整地址，含路径，不要只填域名。
#   本地平台走 nginx：http://localhost/api/openapi/chat
#   线上：https://llmops.shortvar.com/api/openapi/chat（注意该域名证书已过期，截至 2026-10-29 不可用）
LLMOPS_API_BASE=http://localhost/api/openapi/chat

# ---------- 可选：ffmpeg-static（不是 pip 包，需单独下载） ----------
# 不填时脚本只打印提示，视频合成阶段可能失败。
# FFMPEG_PATH=/path/to/ffmpeg-4.4-amd64-static
