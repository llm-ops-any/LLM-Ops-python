# =============================================================================
# LLMOps 部署环境变量模板
# 用法：复制为 .env 后填写 → docker compose 会自动读取同目录的 .env
#   cp .env.example .env
# ⚠️ .env 含敏感凭证，不要提交到 git、不要外发
# =============================================================================

# ---------- 基础设施（必须设置）----------
# 生成方式（Linux）：openssl rand -hex 24
# 生成方式（PowerShell）：[Convert]::ToBase64String([byte[]](1..24|%{Get-Random -Maximum 256})) -replace '[/+=]',''
# ⚠️ 密码请只用字母数字，避免 @ : / 等特殊字符破坏数据库 URI 解析
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
WEAVIATE_API_KEY=

# ---------- 外部服务（按需填写，留空则对应功能不可用）----------

# LLM 服务提供者：至少要配一个，否则无法进行模型对话
# 若使用 OpenAI 兼容的中转平台，填 OPENAI_API_KEY + OPENAI_API_BASE 即可
OPENAI_API_KEY=
OPENAI_API_BASE=
# 知识库向量化模型名；留空则用代码默认值 text-embedding-3-small
# 注意：部分中转平台的阿里 text-embedding 系列与 langchain 参数格式不兼容（报 400），需实测挑选
EMBEDDINGS_MODEL=
# 向量化输出维度：本地预置的 FAISS 索引（辅助 Agent 扩展知识库）写死为 1536
# 必须填 1536，留空则用模型默认维度（如 qwen3-embedding-8b 为 4096），
# 维度不一致时 FAISS 检索会抛 AssertionError: assert d == self.d
EMBEDDINGS_DIMENSIONS=1536
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
qianfan_ak=
qianfan_sk=

# 腾讯云 COS 对象存储：上传应用图标 / 文件时需要
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=

# Github OAuth 登录：不配置则只能使用账号密码登录
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# LangSmith 链路追踪（默认关闭）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=LLMOpsDev

# 辅助 Agent 智能体应用 id 标识（课程默认值，保持即可）
ASSISTANT_AGENT_ID=6774fcef-b594-8008-b30c-a05b8190afe6

# 工具类 API 秘钥
GAODE_API_KEY=
SERPER_API_KEY=
