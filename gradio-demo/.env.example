# gradio-demo 环境变量模板
# 用法：复制为 .env（同目录），按下方说明填真实值。.env 含真实密钥，不得提交。
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# 说明：webui.py 启动时 dotenv.load_dotenv() 读取本目录 .env。

# ---------- LLMOps 开放 API（「获取文案」按钮）----------
# 对话接口完整地址，含路径，不要只填域名。
#   本地平台走 nginx：http://localhost/api/openapi/chat
#   线上：https://llmops.shortvar.com/api/openapi/chat（注意证书有效期）
LLMOPS_API_BASE=http://localhost/api/openapi/chat
# 应用 id：LLMOps 平台 → 应用详情页 URL / 应用设置里取
LLMOPS_APP_ID=your-app-id
# 开放 API 密钥：LLMOps 平台 → 设置 → 开放 API 密钥（形如 llmops-v1/xxx）
LLMOPS_API_KEY=your-llmops-api-key

# ---------- 阿里百炼 TTS（「转换为语音」按钮）----------
# 百炼原生多模态生成接口（注意：不是 OpenAI 兼容的 /compatible-mode/v1/audio/speech，
# 该路径在百炼上返回 404；tts-1 / alloy 这类 OpenAI 模型名在百炼上也不存在）
DASHSCOPE_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_API_KEY=your-dashscope-api-key
# 可用模型：qwen3-tts-flash（qwen-tts 在该账号下报 Model not exist）
TTS_MODEL=qwen3-tts-flash
# 常用音色：Cherry / Serena / Ethan / Chelsie
TTS_VOICE=Cherry
